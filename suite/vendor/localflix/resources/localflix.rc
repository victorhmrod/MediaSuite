#include <winver.h>

IDI_ICON1 ICON "localflix.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LocalFlix"
            VALUE "FileDescription", "LocalFlix offline media library and player"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "localflix"
            VALUE "LegalCopyright", "AGPL-3.0"
            VALUE "OriginalFilename", "localflix.exe"
            VALUE "ProductName", "LocalFlix"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
